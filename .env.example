# Copy to .env and fill in. Never commit .env.

# Required: long random string used to sign login tokens
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Login token lifetime in minutes
TOKEN_EXPIRATION_MINUTES=30

# AI features (PadhAI chat, summaries, Q&A). Without a key the AI endpoints return an error message.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: defaults to SQLite file booksetu.db in the project root
# DATABASE_URL=sqlite:///booksetu.db
